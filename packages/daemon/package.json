{
  "name": "agent-phonon",
  "version": "0.9.1",
  "description": "agent-phonon device daemon — connects to servers, schedules local AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-phonon": "./dist/cli.js"
  },
  "main": "./dist/daemon.js",
  "types": "./dist/daemon.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsup",
    "build:test": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build:test && node --test dist-test/config.test.js dist-test/security.test.js",
    "test:e2e": "pnpm test:e2e:local",
    "test:e2e:local": "pnpm build:test && node --test dist-test/obs.test.js",
    "test:live": "pnpm build:test && node ../../scripts/run-live-tests.mjs dist-test/daemon.test.js",
    "test:all": "pnpm test && pnpm test:e2e:local"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/google": "4.0.50",
    "@ai-sdk/openai": "4.0.43",
    "@ai-sdk/openai-compatible": "^3.0.28",
    "ai": "^7.0.58",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "ws": "^8.18.0",
    "yaml": "2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agent-phonon/core": "workspace:*",
    "@agent-phonon/protocol": "workspace:*",
    "@agent-phonon/test-server": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "author": "agent-phonon contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackerphysics/agent-phonon.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/hackerphysics/agent-phonon#readme",
  "bugs": {
    "url": "https://github.com/hackerphysics/agent-phonon/issues"
  }
}
