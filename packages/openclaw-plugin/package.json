{
  "name": "@agent-phonon/openclaw-plugin",
  "version": "0.1.0",
  "description": "OpenClaw plugin for agent-phonon: bridges before_tool_call → phonon HITL (hook.fired/resolve).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./native-interactions": {
      "types": "./dist/native-interactions.d.ts",
      "import": "./dist/native-interactions.js"
    },
    "./peer-context": {
      "types": "./dist/peer-context.d.ts",
      "import": "./dist/peer-context.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.0"
    }
  },
  "scripts": {
    "build": "tsup",
    "artifact": "node scripts/prepare-artifact.mjs",
    "test": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-phonon/protocol": "workspace:*",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "author": "agent-phonon contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackerphysics/agent-phonon.git",
    "directory": "packages/openclaw-plugin"
  },
  "homepage": "https://github.com/hackerphysics/agent-phonon#readme",
  "bugs": {
    "url": "https://github.com/hackerphysics/agent-phonon/issues"
  },
  "private": true
}
